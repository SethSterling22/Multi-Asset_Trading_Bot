# El Wheel en PAPER (live_trading_mode=false en config.json). Corre siempre; Lumibot
# duerme cuando el mercado está cerrado.
[Unit]
Description=Trading · Wheel (Lumibot + Alpaca, paper)
Documentation=file:///opt/trading/RUNNING.md
After=network-online.target docker.service
Wants=network-online.target
# Un bucle de caídas no es "reintentar": tras 5 fallos en 30 min se queda parado y
# alguien tiene que mirarlo.
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading
EnvironmentFile=/etc/trading/env
ExecStart=/opt/trading/.venv/bin/python -m strategies.wheel
# SIGTERM pide una parada ordenada (strategies/runtime.py) que se fuerza a los 30 s;
# systemd espera 45 s antes de matarlo.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
