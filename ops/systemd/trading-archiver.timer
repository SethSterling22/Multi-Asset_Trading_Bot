# Cada 6 h. Coinalyze conserva ~25 h a 1 minuto: con una ejecución perdida sigue
# habiendo margen. Persistent=true: si la VM estaba apagada cuando tocaba, se ejecuta
# al arrancar, que es justo lo que protege el archivo tras un corte de luz.
[Unit]
Description=Trading · archivador de Coinalyze cada 6 h

[Timer]
OnCalendar=*-*-* 00/6:07:00
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
