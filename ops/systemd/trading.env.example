# /etc/trading/env  (root:trading, 0640). Lo leen las unidades systemd de ops/systemd/.
# Interino hasta SOPS + age (Fase 1.2): es un fichero de secretos en disco.
#
# Solo las claves que hacen falta en este host (DECISIONS.md D-011): las de PAPER de
# Alpaca y la de Coinalyze. Nada de claves de Coinbase todavía.

# La contraseña es la de /etc/trading/pg_password.
DATABASE_URL=postgresql+psycopg://trading:CAMBIAR@127.0.0.1:5432/trading
REDIS_URL=redis://127.0.0.1:6379/0

COINALYZE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Lumibot: sin publicidad en los logs.
LUMIBOT_HIDE_BOTSPOT_TIP=1
