# En el host de Proxmox (Sadida), junto a los contenedores de trading.
#   install -m 755 ops/power/battery-watch.sh /usr/local/sbin/trading-battery-watch
#   install -m 644 ops/power/trading-battery-watch.service /etc/systemd/system/
#   echo 'COMPOSE_FILE=/opt/trading/docker/compose.runtime.yml' > /etc/trading/battery-watch.conf
#   systemctl enable --now trading-battery-watch
[Unit]
Description=Trading · la batería del portátil como UPS de los contenedores de trading
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/trading-battery-watch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
