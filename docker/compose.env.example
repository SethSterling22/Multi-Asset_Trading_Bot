# /etc/trading/compose.env: variables de interpolación del compose, sin secretos.
# Los datos de Postgres y Redis, en el disco grande de Sadida.
TRADING_DATA_DIR=/mnt/data/trading

# Dónde escucha el dashboard. Por defecto solo en el propio host: publícalo en la
# tailnet con `tailscale serve --bg 8000` (HTTPS con certificado válido). Para
# escuchar directamente en la IP de Tailscale del host, pon esa IP (100.x.y.z).
DASHBOARD_BIND=127.0.0.1
