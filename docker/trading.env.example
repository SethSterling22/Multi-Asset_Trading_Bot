# /etc/trading/env  (root, 0600): lo lee docker/compose.runtime.yml como env_file.
# Interino hasta SOPS + age (Fase 1.2): es un fichero de secretos en disco.
#
# Solo lo que hace falta en Sadida (DECISIONS.md D-011/D-012): claves de PAPER de
# Alpaca y la de Coinalyze. Nada de claves de Coinbase todavía.
#
# DATABASE_URL y REDIS_URL NO van aquí: el entrypoint de los contenedores los construye
# con la contraseña de /etc/trading/pg_password y los nombres de servicio del compose.

COINALYZE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
