# Imagen del motor: estrategias, archivador y migraciones (grupo `engine` de uv).
#   docker build -f docker/Dockerfile.engine -t trading-engine .
# Sin secretos dentro (.dockerignore): llegan en ejecución por env_file.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    LUMIBOT_HIDE_BOTSPOT_TIP=1

WORKDIR /app
# Primero solo las dependencias: la capa se reutiliza mientras uv.lock no cambie.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-default-groups --group engine --no-install-project

COPY . .
RUN useradd --system --uid 10001 --home-dir /app trading \
    && mkdir -p /app/logs && chown -R trading:trading /app
USER trading

# Comprueba el risk floor al construir: una imagen con el floor roto no se crea.
RUN python -c "from core import risk_floor; risk_floor.assert_no_mutation()"
